// Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // There is no catch-all rule, so Firestore denies every path not matched below.
    // A new collection needs its own rule here before the app can use it.

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /Users/{uid} {
      allow read, delete: if isOwner(uid);
      // The app reads the uid field as the user's identity, so it must match the document id.
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;

      match /saved_artworks/{artworkId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
