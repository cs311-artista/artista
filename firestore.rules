// Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // There is no catch-all rule, so Firestore denies every path not matched below.
    // A new collection needs its own rule here before the app can use it.

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /Users/{uid} {
      // Friendship is one-way, so anyone who knows a uid may view that user's profile.
      // Only get is allowed, not list, so nobody can download every profile at once.
      allow get: if isSignedIn();
      allow delete: if isOwner(uid);
      // The app reads the uid field as the user's identity, so it must match the document id.
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;

      match /saved_artworks/{artworkId} {
        // Readable by any signed-in user, so friends can see what the owner saved.
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }
    }
  }
}
