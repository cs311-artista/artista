<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.

  The Firebase Authentication emulator answers over plain HTTP, so the instrumented tests that sign
  in against it cannot run while cleartext traffic is forbidden (the default from targetSdk 28 on).
  The exemption is limited to the hosts that can reach a developer machine, and this file is only
  merged into debug builds: release builds keep the platform default of no cleartext at all.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Host loopback, used when the emulators are tunnelled with `adb reverse`. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
